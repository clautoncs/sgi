# SGI - Sistema de Gerenciamento iLinked
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o .env no Git.

# Banco de Dados (TiDB Cloud / MySQL)
DATABASE_URL=mysql://USUARIO:SENHA@HOST:PORTA/sgi?sslaccept=strict

# NextAuth.js - Autenticação
NEXTAUTH_SECRET=GERAR_COM_openssl_rand_-base64_32
NEXTAUTH_URL=https://sgi.ilinked.com.br

# Google OAuth (SSO)
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-seu-secret

# Google Sheets (Service Account)
GOOGLE_CREDENTIALS_PATH=/app/google-credentials.json
GOOGLE_SHEET_ID=id-da-planilha-de-vendas

# Google Gemini (opcional - para IA)
GOOGLE_GEMINI_API_KEY=sua-api-key
